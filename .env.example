# Create .env next to this file and replace the value with the token from @BotFather.
TELEGRAM_BOT_TOKEN=replace_me
ASSET_DIRECTORY=./assets
DATABASE_PATH=./data/magic-pet.db

# Optional. When URL is empty, the bot always uses safe local plans.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=5000

# Safe reset command /reset is enabled only in lesson mode.
APP_MODE=lesson
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_MS=2000
