# Не добавляйте в этот файл настоящие ключи.
# Скопируйте его как .env.lesson-secrets только на школьном компьютере.

# Прямой доступ к OpenAI. Эти значения автоматически попадут в папку занятия.
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini-2024-07-18

# Необязательно: запасной Telegram-токен школы.
# Скрипт не переносит его автоматически: на занятии МОП вставляет в .env
# токен студента или вручную использует этот запасной вариант.
TELEGRAM_BOT_TOKEN=
